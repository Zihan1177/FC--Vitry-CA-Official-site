<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FC Vitry CA Official Site</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f6f8;
      color: #111827;
    }

    header {
      background: #0b1f3a;
      color: white;
      padding: 24px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: 0.5px;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 24px;
      font-weight: 600;
    }

    .hero {
      background: linear-gradient(rgba(11,31,58,0.78), rgba(11,31,58,0.78)),
        url("https://images.unsplash.com/photo-1431324155629-1a6deb1dec8d?auto=format&fit=crop&w=1600&q=80");
      background-size: cover;
      background-position: center;
      color: white;
      padding: 100px 40px;
    }

    .hero h1 {
      font-size: 56px;
      margin: 0 0 16px;
    }

    .hero p {
      font-size: 20px;
      max-width: 650px;
      line-height: 1.6;
    }

    .button {
      display: inline-block;
      margin-top: 24px;
      padding: 14px 22px;
      background: #e21b2d;
      color: white;
      text-decoration: none;
      font-weight: 700;
      border-radius: 6px;
    }

    main {
      max-width: 1100px;
      margin: 40px auto;
      padding: 0 24px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 40px;
    }

    .card {
      background: white;
      border-radius: 8px;
      padding: 24px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }

    .card h2 {
      margin-top: 0;
      color: #0b1f3a;
    }

    .score {
      font-size: 30px;
      font-weight: 800;
      margin: 12px 0;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }

    th, td {
      padding: 16px;
      border-bottom: 1px solid #e5e7eb;
      text-align: left;
    }

    th {
      background: #0b1f3a;
      color: white;
    }

    footer {
      background: #0b1f3a;
      color: white;
      padding: 28px 40px;
      text-align: center;
      margin-top: 60px;
    }

    @media (max-width: 800px) {
      header {
        display: block;
      }

      nav {
        margin-top: 16px;
      }

      nav a {
        display: inline-block;
        margin: 8px 12px 0 0;
      }

      .hero h1 {
        font-size: 38px;
      }

      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="logo">FC Vitry CA</div>
    <nav>
      <a href="#club">Club</a>
      <a href="#matches">Matches</a>
      <a href="#players">Players</a>
      <a href="#stats">Stats</a>
    </nav>
  </header>

  <section class="hero">
    <h1>FC Vitry CA Official Site</h1>
    <p>
      Welcome to the official website of FC Vitry CA. Match results, fixtures,
      player information and team statistics in one place.
    </p>
    <a class="button" href="#matches">View Latest Match</a>
  </section>

  <main>
    <section class="grid" id="club">
      <div class="card">
        <h2>Club Info</h2>
        <p><strong>Team:</strong> FC Vitry CA</p>
        <p><strong>City:</strong> Vitry-sur-Seine</p>
        <p><strong>Level:</strong> Amateur Football Team</p>
      </div>

      <div class="card">
        <h2>Latest Result</h2>
        <p>FC Vitry CA vs Opponent FC</p>
        <div class="score">3 - 1</div>
        <p>Friendly Match</p>
      </div>

      <div class="card">
        <h2>Next Match</h2>
        <p><strong>Date:</strong> Sunday</p>
        <p><strong>Opponent:</strong> To be confirmed</p>
        <p><strong>Venue:</strong> Home Ground</p>
      </div>
    </section>

    <section id="matches">
      <h2>Match Results</h2>
      <table>
        <tr>
          <th>Date</th>
          <th>Match</th>
          <th>Score</th>
          <th>Competition</th>
        </tr>
        <tr>
          <td>2026-07-01</td>
          <td>FC Vitry CA vs Opponent FC</td>
          <td>3 - 1</td>
          <td>Friendly</td>
        </tr>
        <tr>
          <td>2026-06-24</td>
          <td>Paris United vs FC Vitry CA</td>
          <td>2 - 2</td>
          <td>League</td>
        </tr>
      </table>
    </section>

    <section class="grid" id="players" style="margin-top: 40px;">
      <div class="card">
        <h2>#10</h2>
        <p><strong>Name:</strong> Player One</p>
        <p><strong>Position:</strong> Forward</p>
      </div>

      <div class="card">
        <h2>#8</h2>
        <p><strong>Name:</strong> Player Two</p>
        <p><strong>Position:</strong> Midfielder</p>
      </div>

      <div class="card">
        <h2>#1</h2>
        <p><strong>Name:</strong> Player Three</p>
        <p><strong>Position:</strong> Goalkeeper</p>
      </div>
    </section>

    <section id="stats">
      <h2>Team Statistics</h2>
      <table>
        <tr>
          <th>Player</th>
          <th>Goals</th>
          <th>Assists</th>
          <th>Appearances</th>
        </tr>
        <tr>
          <td>Player One</td>
          <td>8</td>
          <td>3</td>
          <td>10</td>
        </tr>
        <tr>
          <td>Player Two</td>
          <td>4</td>
          <td>7</td>
          <td>11</td>
        </tr>
        <tr>
          <td>Player Three</td>
          <td>0</td>
          <td>0</td>
          <td>9</td>
        </tr>
      </table>
    </section>
  </main>

  <footer>
    FC Vitry CA Official Site · Amateur Football Team
  </footer>
</body>
</html>
